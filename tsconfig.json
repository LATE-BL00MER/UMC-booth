{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["api", "src", "tests", "vite.config.ts", "vitest.setup.ts"]
}
